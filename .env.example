# Upstash Redis (add via Vercel Marketplace -> Upstash, or create at upstash.com). Placeholders only.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# (KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.) If unset, an in-memory store is used (local dev only).
